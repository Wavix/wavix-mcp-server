# Example environment file for self-hosted deployments.
# Copy to `.env` and uncomment any variable you want to override.

# Override the upstream Wavix API endpoint.
# Defaults to https://api.wavix.com when unset.
#WAVIX_API_BASE_URL=https://api.wavix.com

# Optional PostHog MCP usage analytics. Unset disables analytics
# entirely; tool calls behave exactly as without it.
#POSTHOG_API_KEY=
# Defaults to https://us.i.posthog.com when POSTHOG_API_KEY is set and
# this is unset.
#POSTHOG_URL=https://us.i.posthog.com
